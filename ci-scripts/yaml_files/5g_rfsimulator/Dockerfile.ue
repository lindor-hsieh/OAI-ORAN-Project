# 使用官方開發版作為基底
FROM oaisoftwarealliance/oai-nr-ue:develop

# 切換到 root 權限進行安裝
USER root

# 安裝網路工具、路由工具、測速工具與除錯工具
# 1. iptables/iproute2: IAB Node 做 NAT 轉發必備
# 2. iperf3: 論文數據測速必備
# 3. tcpdump: 抓包除錯必備 (強烈建議加入！)
# 4. net-tools: 提供 ifconfig, netstat 等傳統工具
# 5. ethtool: 檢查網卡卸載 (Offload) 狀態，有助於優化效能
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
    iptables \
    iproute2 \
    iputils-ping \
    iperf3 \
    tcpdump \
    net-tools \
    ethtool \
    && rm -rf /var/lib/apt/lists/*

# 確保容器啟動時使用 root 權限 (建立 TUN 介面需要 root)
USER root

# (可選) 設定預設工作目錄
WORKDIR /opt/oai-nr-ue